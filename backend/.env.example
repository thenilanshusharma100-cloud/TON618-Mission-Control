# TON618 Mission Control - Backend Environment Configuration
# Copy this file to .env and adjust values for your deployment.
# Do not commit actual secrets to version control.

# Database configuration
TON618_DATABASE_URL=sqlite:///./var/ton618.db

# Reference data and component catalog directory (relative to backend/)
TON618_CATALOG_DIR=../data

# API settings
TON618_APP_NAME=TON618 Mission Control
TON618_APP_VERSION=0.1.0

# CORS configuration - origins allowed to make cross-origin requests
# Comma-separated list; use "*" for development only
TON618_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Server binding is set with uvicorn flags:
# uv run uvicorn app.main:app --host 0.0.0.0 --port 8000
