# TON618 Mission Control - Frontend Environment Configuration
# Copy this file to .env and adjust values for your deployment.
# Do not commit actual secrets to version control.

# Backend origin. Used as the Vite dev proxy target and as <origin>/api for
# production builds. Leave unset to use /api through the proxy in development.
VITE_API_BASE_URL=http://127.0.0.1:8000
